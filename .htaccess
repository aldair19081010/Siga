# Ocultar errores en producción
php_flag display_errors off

# Proteger archivos sensibles
<FilesMatch "^(\.env|config\.php|db_connect\.php|verificacion_produccion\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevenir visualización de directorios
Options -Indexes

# Proteger contra ataques XSS
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Reescritura de URLs (si lo necesitas)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirigir a HTTPS (descomenta estas líneas cuando tengas SSL)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Evitar acceso a archivos .git, .env, etc.
    RewriteRule ^(.git|.env|vendor) - [F,L,NC]
</IfModule>

# Configurar caché para mejorar rendimiento
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>